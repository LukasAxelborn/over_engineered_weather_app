# =============================================================================
# Weather platform — environment variables.
# Copy to `.env` and edit before first run:  cp .env.example .env
# =============================================================================

COMPOSE_PROJECT_NAME=weather
TZ=Europe/Stockholm
LOG_LEVEL=INFO

# --- Postgres (also used by Umami/GlitchTip) ---------------------------------
POSTGRES_USER=weather
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=weather
BACKUP_RETENTION=14

# --- BFF rate limiting (per client, per window) ------------------------------
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60

# --- CORS (leave empty for same-origin production) --------------------------
CORS_ORIGINS=

# --- Worker pre-warm ---------------------------------------------------------
WORKER_CITIES=Stockholm,London,New York,Tokyo,Paris
WORKER_INTERVAL_SEC=3600

# --- Grafana ------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana

# --- Service secrets (set before enabling the matching profile) ---------------
UMAMI_APP_SECRET=change-me-umami
GLITCHTIP_SECRET_KEY=change-me-glitchtip
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
